# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fincalc:CHANGE_ME_DB_PASSWORD@postgres:5432/fincalc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Générez avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN
NEXTAUTH_URL=https://finance.votre-domaine.com

# ─── Compte admin initial ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Admin

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Créez sur console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Redirect URI à autoriser : https://votre-domaine.com/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME

# ─── APIs financières ─────────────────────────────────────────────────────────
# Finnhub — cours boursiers & ETFs en temps réel (gratuit sur finnhub.io)
FINNHUB_API_KEY=votre_cle_finnhub

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret partagé entre le service cron et le endpoint /api/cron/snapshot
# Générez avec: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_CRON_SECRET
