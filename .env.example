# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fincalc:CHANGE_ME_DB_PASSWORD@postgres:5432/fincalc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Générez avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN
NEXTAUTH_URL=https://finance.votre-domaine.com

# ─── Compte admin initial ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Admin
