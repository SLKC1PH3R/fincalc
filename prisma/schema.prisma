generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  emailVerified  DateTime?            // Requis par NextAuth PrismaAdapter
  name           String?
  password       String?              // Nullable — null pour les comptes Google OAuth
  image          String?              // Avatar URL ou base64
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lastLoginAt    DateTime?
  simulations    Simulation[]
  sessions       Session[]
  accounts       Account[]
  portfolio      Portfolio?
  scores         PatrimoineScore[]
  snapshots      PatrimoineSnapshot[]
}

model PatrimoineScore {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  details   Json     // { savings, emergency, diversification, retirement, fiscal, debt }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Simulation {
  id         String   @id @default(cuid())
  userId     String
  type       String
  name       String
  inputs     Json
  results    Json
  shareToken String?  @unique  // null = privé, token UUID = lien public actif
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Portfolio {
  id        String               @id @default(cuid())
  userId    String               @unique
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions PortfolioPosition[]
  envelopes PatrimoineEnvelope[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model PortfolioPosition {
  id          String              @id @default(cuid())
  portfolioId String
  portfolio   Portfolio           @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  envelopeId  String?
  envelope    PatrimoineEnvelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  assetType   String              // STOCK | ETF | CRYPTO | SCPI | LIVRET | CASH
  symbol      String              // AAPL, bitcoin, CW8.PA, "Livret A"...
  name        String              // Nom d'affichage
  isin        String?             // Code ISIN (optionnel)
  quantity    Float
  pru         Float               // Prix de Revient Unitaire en EUR
  currency    String              @default("EUR")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([portfolioId])
  @@index([envelopeId])
}

model PatrimoineEnvelope {
  id          String              @id @default(cuid())
  portfolioId String
  portfolio   Portfolio           @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  type        String              // LIVRET | IMMOBILIER | PEA | AV | CTO | CRYPTO | PER | CASH
  name        String
  metadata    Json                @default("{}")
  sortOrder   Int                 @default(0)
  positions   PortfolioPosition[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([portfolioId])
}

model PatrimoineSnapshot {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  totalValue  Float
  byEnvelope  Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
